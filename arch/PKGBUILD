# Maintainer: CharOfString <root@charofstring.cc>
pkgname=deepin-qt5integration-git
pkgver=6.7.44
pkgrel=1
pkgdesc='Qt 5 platform theme integration plugins for DDE (DTK5)'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/dde-qt5integration"
license=('LGPL-3.0-or-later' 'LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only')
# 与 debian/control 相同，运行时需要 dxcb 平台插件 ・ As in debian/control, the dxcb platform plugin is needed at runtime.
depends=('dtkcore-git' 'dtkgui-git' 'dtkwidget-git' 'deepin-qt5platform-plugins-git' 'qt5-base'
         'qt5-svg' 'qt5-x11extras' 'libqt5xdg' 'libx11' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'qt5-tools' 'dtkcommon-git' 'xcb-util-renderutil')
provides=("deepin-qt5integration=$pkgver" 'libqt5deepintheme-plugin')
conflicts=('deepin-qt5integration' 'libqt5deepintheme-plugin')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  # 与 debian/rules 相同（DTK5）；插件装到 Arch 的 Qt 5 插件目录 lib/qt/plugins
  # Same as debian/rules (DTK5); the plugins go to Arch's Qt 5 plugin directory lib/qt/plugins.
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DDTK5=ON \
    -DBUILD_TESTING=OFF \
    -DPLUGIN_INSTALL_BASE_DIR=lib/qt/plugins
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
